# Projeto de desenvolvimento: ar-acessorios-dev (São Paulo).
NEXT_PUBLIC_SUPABASE_URL=https://pmhipriryqsblhonysay.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XNyn7AzoeL6IejNG8NM9uQ_9Sm5dtd8

# Avisos push do painel (NOT-DEC-001). Gerar o par com: npx web-push generate-vapid-keys
# A pública vai no site; a PRIVADA só em .env.local e nas variáveis do servidor (Vercel), nunca no repositório.
# VAPID_SUBJECT: contato da loja para a Apple/Google (mailto: ou https:); [A DEFINIR] pela dona.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:[A DEFINIR]
