      "css": ".ds-bnav{display:grid;grid-template-columns:repeat(4,1fr);width:360px;background:rgba(255,249,244,.97);border-top:1px solid #E8DAD0;padding:6px 8px;font-family:Jost,system-ui,sans-serif}.ds-bnav a{position:relative;display:flex;align-items:center;justify-content:center;min-height:52px;font-size:12px;color:#6B4E3D;text-decoration:none;border-radius:14px}.ds-bnav a.on{color:#38291F;font-weight:500}.ds-bnav a.on::before{content:'';position:absolute;top:-7px;width:26px;height:2px;background:#C89F7A;border-radius:2px}.ds-bnav a:focus-visible{outline:2px solid #38291F;outline-offset:2px}"
