      "html": "<button class=\"ds-btn-p\">Adicionar à sacola</button>",
      "css": ".ds-btn-p{font-family:Jost,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 30px;border-radius:999px;font-size:15px;font-weight:500;letter-spacing:.05em;cursor:pointer;transition:background .25s,color .25s;background:#38291F;color:#FDF6F0;border:0}.ds-btn-p:hover{background:#4D3A2C}.ds-btn-p:focus-visible{outline:2px solid #38291F;outline-offset:2px}"
