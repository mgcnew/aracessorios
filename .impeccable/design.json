      "html": "<button class=\"ds-btn-s\">Conhecer os kits</button>",
      "css": ".ds-btn-s{font-family:Jost,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 30px;border-radius:999px;font-size:15px;font-weight:500;letter-spacing:.05em;cursor:pointer;transition:background .25s,color .25s;background:transparent;color:#38291F;border:1px solid #38291F}.ds-btn-s:hover{background:#EAD9C6}.ds-btn-s:focus-visible{outline:2px solid #38291F;outline-offset:2px}"
