      "css": ".ds-pc{display:flex;flex-direction:column;gap:4px;width:220px;color:#38291F;text-decoration:none;font-family:Jost,system-ui,sans-serif}.ds-pc-m{position:relative;display:block;aspect-ratio:4/5;border-radius:18px;background:#EAD9C6;margin-bottom:8px;overflow:hidden;transition:transform .6s cubic-bezier(.2,.7,.2,1)}.ds-pc:hover .ds-pc-m{transform:translateY(-2px)}.ds-pc-b{position:absolute;left:12px;top:14px;background:#FFF9F4;color:#6B4E3D;font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border-radius:999px}.ds-pc-c{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#6B4E3D}.ds-pc-n{font-family:'Cormorant Garamond',Georgia,serif;font-size:21px;font-weight:600;line-height:1.15}.ds-pc-p{font-size:15px;font-weight:500}"
